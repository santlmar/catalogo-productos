# Copia este archivo a `.env` (no se versiona) y ajusta los valores.
# Configuración mínima para arrancar en local SIN servicios externos:
STORAGE_PROVIDER=memory
CACHE_PROVIDER=memory
KAFKA_ENABLED=false

# ---------------------------------------------------------------- Aplicación
NODE_ENV=development
PORT=3001

# ------------------------------------------------- Backblaze B2 (Guía 9)
# b2 (bucket privado vía API S3) | memory (solo desarrollo, se pierde al reiniciar)
# STORAGE_PROVIDER=b2
# Endpoint S3 que aparece en el resumen del bucket.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# Opcional: si se omite se deduce del endpoint (us-east-005).
B2_REGION=
B2_BUCKET=
# Application Key restringida al bucket (Read and Write): keyID y applicationKey.
B2_KEY_ID=
B2_APPLICATION_KEY=
# Vigencia de las URLs firmadas de descarga de imágenes.
B2_SIGNED_URL_TTL_SECONDS=900

# ------------------------------------------------------- Valkey (Guía 10)
# valkey (Aiven) | memory (solo desarrollo)
# CACHE_PROVIDER=valkey
# Service URI de Aiven: rediss://default:<password>@<host>:<port>
VALKEY_URL=
CACHE_TTL_SECONDS=300
CACHE_TIMEOUT_MS=1000

# --------------------------------------------------------------------- Kafka
# KAFKA_ENABLED=true
KAFKA_BROKERS=
KAFKA_CLIENT_ID=product-service
# El tópico debe crearse antes en la consola de Aiven.
KAFKA_TOPIC_PRODUCT_EVENTS=product-events

# TLS (Aiven). Los PEM se pueden pegar en una línea usando \n literales.
KAFKA_SSL=true
KAFKA_SSL_CA=

# Autenticación por certificado de cliente (mTLS):
KAFKA_SSL_CERT=
KAFKA_SSL_KEY=
# Autenticación SASL (alternativa): plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
